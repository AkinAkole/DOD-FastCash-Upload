import io
import math
import os
import zipfile
import numpy as np
import openpyxl
from openpyxl.styles import Alignment, Border, Font, PatternFill, Side
import pandas as pd

import ipywidgets as widgets
from IPython.display import HTML, display

# ==========================================
# UI COMPONENTS & DESIGN
# ==========================================

display(
    HTML("""
<style>
    .widget-box { background-color: #f7f9fa; border-radius: 8px; border: 1px solid #e1e4e6; padding: 20px; }
    .widget-title { color: #1a365d; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
    .widget-button { font-weight: bold; background-color: #2b6cb0 !important; color: white !important; }
    .fallback-text { font-size: 12px; color: #4a5568; font-style: italic; margin-top: 5px; }
</style>
""")
)

title_html = widgets.HTML(
    "<h1 class='widget-title' style='margin-bottom: 2px;'>DOD FastCash Engine</h1>"
)
subtitle_html = widgets.HTML(
    "<p style='color: #718096; margin-top: 0; font-size: 14px;'>FastCash Upload Files Generator</p><hr style='border: 0; border-top: 1px solid #cbd5e0;'>"
)

contra_acc_w = widgets.Text(
    description="Contra Account:", placeholder="Alphanumeric account code"
)
tran_type_w = widgets.Dropdown(
    options=["D", "C"], description="Tran_Type (D/C):", value="D"
)
contra_amt_w = widgets.FloatText(description="Contra Amount:", value=0.0)
out_sheet_name_w = widgets.Text(
    description="Output Sheet Name:", value="FastCash_Batch"
)
contra_narr_w = widgets.Text(
    description="Contra Narration:", placeholder="Max 40 chars"
)
ref_prefix_w = widgets.Text(description="Ref. Prefix:", placeholder="e.g., FAST//")
inc_pos_w = widgets.Checkbox(
    description="Include cell position details", value=True
)

file_upload_w = widgets.FileUpload(
    accept=".xlsx, .xls, .xlsb",
    multiple=False,
    description="1. Click to Upload File",
    layout=widgets.Layout(width="220px"),
)

file_path_w = widgets.Text(
    description="OR local path:",
    placeholder="e.g., data/input.xlsb (Fallback alternative)",
    layout=widgets.Layout(width="400px"),
)

inputs_layout = widgets.VBox(
    [
        contra_acc_w,
        tran_type_w,
        contra_amt_w,
        out_sheet_name_w,
        contra_narr_w,
        ref_prefix_w,
        inc_pos_w,
        widgets.HTML("<b>Select Input File Method:</b>"),
        widgets.HBox([file_upload_w]),
        widgets.HTML(
            "<div class='fallback-text'>Method A: Upload directly via button above. If widget state locks up, use Method B:</div>"
        ),
        file_path_w,
    ]
)
form_container = widgets.VBox([title_html, subtitle_html, inputs_layout])
form_container.add_class("widget-box")

process_btn = widgets.Button(
    description="Process Data & Generate Output", layout=widgets.Layout(width="300px")
)
process_btn.add_class("widget-button")
output_area = widgets.Output()

display(form_container)
display(widgets.Box([process_btn], layout=widgets.Layout(padding="15px 0px")))
display(output_area)

# ==========================================
# ENGINE / PROCESSING LOGIC
# ==========================================


def process_fastcash_engine(b):
    output_area.clear_output()
    with output_area:
        contra_narr = contra_narr_w.value
        if len(contra_narr) > 40:
            print(
                f"❌ Contra Narration exceeds 40 characters (Currently {len(contra_narr)})."
            )
            return

        file_content = None
        file_name = ""
        use_manual_path = False

        val = file_upload_w.value
        if val:
            try:
                if isinstance(val, list) and len(val) > 0:
                    uploaded_file = val[-1]
                    file_content = uploaded_file["content"]
                    file_name = uploaded_file["name"].lower()
                elif isinstance(val, dict) and len(val) > 0:
                    last_key = list(val.keys())[-1]
                    uploaded_file = val[last_key]
                    file_content = uploaded_file["content"]
                    file_name = uploaded_file.get("metadata", {}).get(
                        "name", last_key
                    ).lower()
                elif hasattr(val, "values"):
                    uploaded_file = next(iter(val.values()))
                    file_content = uploaded_file["content"]
                    file_name = uploaded_file.get("metadata", {}).get(
                        "name", "file"
                    ).lower()
            except Exception:
                pass

        if file_content is None:
            target_path = file_path_w.value.strip()
            if target_path and os.path.exists(target_path):
                print(f"📖 Direct Path Read Triggered: Reading from {target_path}")
                file_name = target_path.lower()
                use_manual_path = True
            elif target_path:
                print(
                    f"❌ Path Fallback Error: Specified path '{target_path}' does not exist."
                )
                return
            else:
                print(
                    "❌ No file detected via upload button or path input field.\n"
                    "👉 If the upload button froze, type the filename into 'OR local path' box above."
                )
                return

        print("⏳ Ingesting data sheet processing layout...")

        try:
            if use_manual_path:
                if file_name.endswith(".xlsb"):
                    df_in = pd.read_excel(
                        target_path, sheet_name=0, engine="pyxlsb"
                    )
                else:
                    df_in = pd.read_excel(target_path, sheet_name=0)
            else:
                if file_name.endswith(".xlsb"):
                    df_in = pd.read_excel(
                        io.BytesIO(file_content), sheet_name=0, engine="pyxlsb"
                    )
                else:
                    df_in = pd.read_excel(io.BytesIO(file_content), sheet_name=0)
        except Exception as e:
            print(f"❌ Error parsing file structure: {str(e)}")
            return

        df_in["_excel_row_idx"] = df_in.index + 2

        col_e_name = df_in.columns[4]
        df_in[col_e_name] = pd.to_numeric(df_in[col_e_name], errors="coerce")
        df_filtered = df_in.dropna(subset=[col_e_name]).copy()

        chunks = []
        current_chunk = []
        current_rows = 0
        current_sum = 0.0

        for _, row in df_filtered.iterrows():
            val_e = float(row[col_e_name])

            if (current_rows + 1 > 7999) or (current_sum + val_e >= 500000000):
                if current_chunk:
                    chunks.append(pd.DataFrame(current_chunk))
                current_chunk = [row]
                current_rows = 1
                current_sum = val_e
            else:
                current_chunk.append(row)
                current_rows += 1
                current_sum += val_e

        if current_chunk:
            chunks.append(pd.DataFrame(current_chunk))

        if not chunks:
            print(
                "❌ No valid rows found containing numbers in Column E for processing."
            )
            return

        # Prepare modern dictionary container to store generated CSV data streams
        csv_buffers = {}

        wb = openpyxl.Workbook()
        default_sheet = wb.active
        wb.remove(default_sheet)

        summary_data = []
        all_contra_rows_sum = 0.0
        total_processed_records = 0

        for idx, chunk_df in enumerate(chunks, 1):
            sheet_title = f"{out_sheet_name_w.value} {idx}"
            ws = wb.create_sheet(title=sheet_title)

            processed_rows = []
            chunk_sum = 0.0
            chunk_row_count = 0

            for _, r in chunk_df.iterrows():
                val_a = str(r.iloc[0]) if pd.notnull(r.iloc[0]) else ""
                val_b = r.iloc[1] if pd.notnull(r.iloc[1]) else ""
                val_e = float(r[col_e_name])
                val_f = str(r.iloc[5]) if pd.notnull(r.iloc[5]) else ""
                val_g = r.iloc[6] if pd.notnull(r.iloc[6]) else ""

                letter_a = val_a[0].upper() if val_a else ""
                rounded_e = round(val_e, 2)
                chunk_sum += rounded_e
                chunk_row_count += 1

                sanitized_val_f = val_f.replace(",", "*").replace("-", "*")

                ref_prefix_base = ref_prefix_w.value
                if inc_pos_w.value:
                    ref_col_f = f"{ref_prefix_base}E{r['_excel_row_idx']}"
                else:
                    ref_col_f = ref_prefix_base

                processed_rows.append(
                    [
                        val_b,
                        letter_a,
                        rounded_e,
                        sanitized_val_f,
                        "",
                        ref_col_f,
                        "",
                        "",
                        "",
                        val_g,
                    ]
                )

            for row_data in processed_rows:
                ws.append(row_data)

            final_chunk_sum = round(chunk_sum, 2)
            all_contra_rows_sum += final_chunk_sum
            total_processed_records += chunk_row_count

            contra_ref_f = f"{ref_prefix_w.value}{sheet_title}"
            contra_row = [
                contra_acc_w.value,
                tran_type_w.value,
                final_chunk_sum,
                contra_narr,
                "",
                contra_ref_f,
                "",
                "",
                "",
                "",
            ]
            ws.append(contra_row)

            # Generate and capture CSV snapshot from calculated dataset layout
            all_sheet_rows = processed_rows + [contra_row]
            csv_df = pd.DataFrame(all_sheet_rows)
            csv_text_buffer = io.StringIO()
            csv_df.to_csv(csv_text_buffer, index=False, header=False)
            csv_buffers[f"{sheet_title}.csv"] = csv_text_buffer.getvalue()

            for row in ws.iter_rows(
                min_row=1, max_row=ws.max_row, min_col=1, max_col=10
            ):
                row[2].number_format = "#,##0.00"

            last_row_idx = ws.max_row
            accent_fill = PatternFill(
                start_color="EBF8FF", end_color="EBF8FF", fill_type="solid"
            )
            for col_idx in range(1, 11):
                cell = ws.cell(row=last_row_idx, column=col_idx)
                cell.font = Font(bold=True, color="1A365D")
                cell.fill = accent_fill

            summary_data.append(
                {
                    "sheet": sheet_title,
                    "row_count": chunk_row_count,
                    "imported_sum": final_chunk_sum,
                    "contra_sum": final_chunk_sum,
                    "variance": 0.0,
                }
            )

        # ==========================================
        # EXECUTIVE SUMMARY SHEET GENERATION
        # ==========================================
        ws_sum = wb.create_sheet(title="Executive Summary", index=0)
        ws_sum.views.sheetView[0].showGridLines = True

        navy_fill = PatternFill(
            start_color="1A365D", end_color="1A365D", fill_type="solid"
        )
        accent_bar_fill = PatternFill(
            start_color="2B6CB0", end_color="2B6CB0", fill_type="solid"
        )
        white_font = Font(name="Segoe UI", size=11, bold=True, color="FFFFFF")
        header_font = Font(name="Segoe UI", size=16, bold=True, color="1A365D")
        bold_font = Font(name="Segoe UI", size=11, bold=True)
        regular_font = Font(name="Segoe UI", size=11)

        thin_border = Border(
            left=Side(style="thin", color="CBD5E0"),
            right=Side(style="thin", color="CBD5E0"),
            top=Side(style="thin", color="CBD5E0"),
            bottom=Side(style="thin", color="CBD5E0"),
        )

        ws_sum.cell(row=2, column=2, value="DOD FastCash Engine").font = header_font
        ws_sum.cell(
            row=3, column=2, value="Executive Processing Summary Report"
        ).font = Font(name="Segoe UI", size=11, italic=True, color="4A5568")

        ws_sum.cell(row=5, column=2, value="Global Reconciliation Table").font = (
            bold_font
        )
        headers_glob = ["Metric Parameter Description", "Value Data"]
        for c_idx, h in enumerate(headers_glob, start=2):
            cell = ws_sum.cell(row=6, column=c_idx, value=h)
            cell.fill = navy_fill
            cell.font = white_font
            cell.alignment = Alignment(horizontal="center")

        global_metrics = [
            ("Total Actionable Data Rows Processed", total_processed_records),
            ("Target Global Contra Amount Inputted", contra_amt_w.value),
            ("Calculated Net Sum of Generated Rows", all_contra_rows_sum),
            (
                "Net Overall Variance Status",
                round(all_contra_rows_sum - contra_amt_w.value, 2),
            ),
        ]

        for r_idx, (metric, val) in enumerate(global_metrics, start=7):
            c1 = ws_sum.cell(row=r_idx, column=2, value=metric)
            c2 = ws_sum.cell(row=r_idx, column=3, value=val)
            c1.font = regular_font
            c2.font = bold_font
            if isinstance(val, float):
                c2.number_format = "#,##0.00"
            else:
                c2.number_format = "#,##0"
            c1.border = thin_border
            c2.border = thin_border
            if "Variance" in metric:
                if val != 0:
                    c2.font = Font(name="Segoe UI", bold=True, color="E53E3E")
                else:
                    c2.font = Font(name="Segoe UI", bold=True, color="38A169")

        start_row_breakdown = 13
        ws_sum.cell(
            row=start_row_breakdown,
            column=2,
            value="Batch Data Sheet Breakdown Variance Log",
        ).font = bold_font
        headers_breakdown = [
            "Output Sheet Identifier",
            "Data Row Count",
            "Imported Rows Sum (Col C)",
            "Created Contra Row (Col C)",
            "Variance Verification",
        ]

        for c_idx, h in enumerate(headers_breakdown, start=2):
            cell = ws_sum.cell(row=start_row_breakdown + 1, column=c_idx, value=h)
            cell.fill = accent_bar_fill
            cell.font = white_font
            cell.alignment = Alignment(horizontal="center")

        curr_row = start_row_breakdown + 2
        for item in summary_data:
            cells = [
                ws_sum.cell(row=curr_row, column=2, value=item["sheet"]),
                ws_sum.cell(row=curr_row, column=3, value=item["row_count"]),
                ws_sum.cell(
                    row=curr_row, column=4, value=item["imported_sum"]
                ),
                ws_sum.cell(row=curr_row, column=5, value=item["contra_sum"]),
                ws_sum.cell(row=curr_row, column=6, value=item["variance"]),
            ]

            cells[0].font = regular_font
            cells[1].font = regular_font
            cells[2].font = regular_font
            cells[3].font = regular_font
            cells[4].font = bold_font

            cells[1].number_format = "#,##0"
            cells[2].number_format = "#,##0.00"
            cells[3].number_format = "#,##0.00"
            cells[4].number_format = "#,##0.00"

            for c in cells:
                c.border = thin_border

            curr_row += 1

        for ws_obj in wb.worksheets:
            for col in ws_obj.columns:
                max_len = max(len(str(cell.value or "")) for cell in col)
                col_letter = openpyxl.utils.get_column_letter(col[0].column)
                ws_obj.column_dimensions[col_letter].width = max(max_len + 3, 12)

        # Write Excel file to binary stream
        excel_buffer = io.BytesIO()
        wb.save(excel_buffer)
        excel_data = excel_buffer.getvalue()

        # ==========================================
        # ZIP ARCHIVE ASSEMBLY
        # ==========================================
        zip_buffer = io.BytesIO()
        with zipfile.ZipFile(
            zip_buffer, "w", compression=zipfile.ZIP_DEFLATED
        ) as zip_file:
            # 1. Add Excel file
            excel_filename = f"{out_sheet_name_w.value}_Processed.xlsx"
            zip_file.writestr(excel_filename, excel_data)

            # 2. Add individual CSV files
            for csv_name, csv_content in csv_buffers.items():
                zip_file.writestr(csv_name, csv_content)

        zip_buffer.seek(0)
        b64_zip = base64.b64encode(zip_buffer.read()).decode()

        # Define download container name
        zip_output_name = f"{out_sheet_name_w.value}_Package.zip"

        dl_link_html = f"""
        <div style="margin-top: 15px; padding: 12px; background-color: #f0fff4; border: 1px solid #c6f6d5; border-radius: 6px;">
            <span style="color: #22543d; font-weight: bold;">✓ Compression and Generation Completed Successfully!</span><br>
            <span style="color: #4a5568; font-size: 13px;">The download package contains the formatted Workbook + individual CSV files for each batch segment.</span><br><br>
            <a href="data:application/zip;base64,{b64_zip}" 
               download="{zip_output_name}" 
               style="background-color: #2b6cb0; color: white; padding: 10px 20px; text-decoration: none; border-radius: 4px; font-weight: bold; display: inline-block;">
               📥 Click to Download All Output Files (.ZIP)
            </a>
        </div>
        """
        display(HTML(dl_link_html))


process_btn.on_click(process_fastcash_engine)